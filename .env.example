# Copy to .env.local (local dev) or set in your host's environment settings.
# NEVER commit real credentials.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public URL of the deployment (used for Stripe redirects, sitemap, metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Contact address shown on the Privacy and Terms pages
NEXT_PUBLIC_SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only. Needed for billing (Stripe webhook) and the E2E test script.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# AI provider (required for text + image generation)
# Any OpenAI-compatible API works:
#   OpenAI:       OPENAI_BASE_URL=https://api.openai.com/v1, OPENAI_API_KEY required
#   OpenRouter:   OPENAI_BASE_URL=https://openrouter.ai/api/v1, OPENAI_API_KEY required
#   Pollinations: OPENAI_BASE_URL=https://text.pollinations.ai/openai, OPENAI_TEXT_MODEL=openai
#                 (keyless, for local testing only: rate limited to ~1 reply / 30s per IP)
# ---------------------------------------------------------------------------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3

# ---------------------------------------------------------------------------
# Stripe (optional; paid plans are hidden until configured)
# Create one recurring monthly Price per paid plan in Stripe and paste its ID.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_ENTERPRISE=
