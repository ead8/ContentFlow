# Copy this file to .env.local and fill in your own values.
# NEVER commit real credentials to the repository.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL of the app, no trailing slash. Used for OAuth redirect URIs
# (${NEXT_PUBLIC_APP_URL}/api/social/{slug}/callback), email links and Stripe
# return URLs. Must match exactly what you register with each platform.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service-role key: server only (OAuth callback, publisher, cron). Never expose
# it in a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# Security (required for social publishing)
# ---------------------------------------------------------------------------
# 32-byte key, base64, used to encrypt social OAuth tokens at rest (AES-256-GCM).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes every stored token unreadable (users must reconnect).
TOKEN_ENCRYPTION_KEY=

# Shared secret for /api/cron/publish and /api/cron/sync-analytics
# (sent as "Authorization: Bearer $CRON_SECRET"; Vercel Cron does this for you).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ---------------------------------------------------------------------------
# AI provider (required for AI content + image generation)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible API works. Pick one:
#   OpenAI:       OPENAI_BASE_URL=https://api.openai.com/v1 (default), OPENAI_API_KEY required
#   OpenRouter:   OPENAI_BASE_URL=https://openrouter.ai/api/v1, free :free models,
#                 free API key from openrouter.ai (no credit card), e.g.
#                 OPENAI_TEXT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#   Pollinations: OPENAI_BASE_URL=https://text.pollinations.ai/openai, no key needed,
#                 OPENAI_TEXT_MODEL=openai (image generation is routed automatically)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key
# Optional overrides (defaults: gpt-4o-mini / dall-e-3)
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3

# External media APIs (optional — needed only for video generation)
SHOTSTACK_API_KEY=your-shotstack-api-key
TAVUS_API_KEY=your-tavus-api-key

# ---------------------------------------------------------------------------
# Social platforms (each one is optional; a platform shows as "not configured"
# in Settings until its id + secret are set). See README "Connecting social
# platforms" for where to create each app and which approvals you need.
# Redirect URI to register: ${NEXT_PUBLIC_APP_URL}/api/social/{slug}/callback
# ---------------------------------------------------------------------------
# LinkedIn — slug: linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional: LinkedIn Marketing API version, YYYYMM (adapter default is recent).
LINKEDIN_API_VERSION=
# Optional: "true" to also request company-page scopes (r_organization_admin,
# w_organization_social). Only after the Community Management API is approved.
LINKEDIN_ORG_SCOPES=false

# Meta (Facebook Pages + Instagram professional accounts) — slugs: facebook, instagram
# META_APP_SECRET also verifies Meta's data deletion callback
# (${NEXT_PUBLIC_APP_URL}/api/social/meta/data-deletion).
META_APP_ID=
META_APP_SECRET=
# Optional: Graph API version (default v26.0).
META_GRAPH_VERSION=
# Optional: Facebook Login for Business configuration ids. When set, config_id
# is sent instead of the scope list.
META_FACEBOOK_CONFIG_ID=
META_INSTAGRAM_CONFIG_ID=
# Optional: extra permissions, comma-separated, e.g. business_management
# (Pages owned through a Business portfolio / Business Manager role).
META_EXTRA_SCOPES=

# X (Twitter) — slug: x  (OAuth 2.0 client id/secret, confidential client)
X_CLIENT_ID=
X_CLIENT_SECRET=

# TikTok — slug: tiktok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional: override requested scopes (comma-separated). Default:
# user.info.basic,user.info.profile,user.info.stats,video.publish,video.list
# Every scope must also be enabled on the TikTok app.
TIKTOK_SCOPES=
# Optional: preferred privacy level, e.g. PUBLIC_TO_EVERYONE (default),
# MUTUAL_FOLLOW_FRIENDS, FOLLOWER_OF_CREATOR, SELF_ONLY. Falls back to what the
# creator allows. Unaudited apps can only post SELF_ONLY.
TIKTOK_PRIVACY_LEVEL=

# YouTube (Google OAuth client, "Web application") — slug: youtube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: public | unlisted | private (default public). Uploads from an
# unaudited Google Cloud project are forced to private by YouTube.
YOUTUBE_PRIVACY_STATUS=public

# ---------------------------------------------------------------------------
# Email notifications (optional; in-app notifications work without it)
# ---------------------------------------------------------------------------
# Resend API key (resend.com). The EMAIL_FROM domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="ContentFlow <notifications@yourdomain.com>"

# ---------------------------------------------------------------------------
# Stripe billing (optional; required to sell paid plans)
# ---------------------------------------------------------------------------
# Checkout, the customer portal and the webhook run as Supabase Edge Functions,
# so STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, APP_URL and the STRIPE_PRICE_*
# values must ALSO be set as Supabase secrets:
#   supabase secrets set STRIPE_SECRET_KEY=sk_... STRIPE_WEBHOOK_SECRET=whsec_... \
#     APP_URL=https://app.example.com STRIPE_PRICE_CREATOR=price_... (etc.)
# STRIPE_SECRET_KEY is ALSO needed in the Next.js server env (never as
# NEXT_PUBLIC_*): DELETE /api/account uses it to cancel the user's
# subscriptions before deleting the account, and refuses to delete an account
# that has a Stripe customer when it is missing. It also lets
# GET /api/credits/plans show live prices. (Legacy names
# NEXT_PRIVATE_STRIPE_SECRET_KEY / NEXT_PRIVATE_STRIPE_WEBHOOK_SECRET are still read.)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring monthly Price IDs, one per paid plan (see lib/billing/plans.ts).
# Plans without a price are shown but cannot be bought.
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_ENTERPRISE=
# Optional (Supabase secret): customer portal configuration id (bpc_...).
STRIPE_PORTAL_CONFIGURATION=
