# Copy to .env.local (local dev) or set in your host's environment settings.
# NEVER commit real credentials. Run `npm run check:env` to validate.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL, no trailing slash. Used for OAuth redirect URIs
# (${NEXT_PUBLIC_APP_URL}/api/social/{slug}/callback), email links, Stripe
# redirects and the sitemap. Must match what you register with each platform.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Contact address shown on the Privacy and Terms pages
NEXT_PUBLIC_SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server only (OAuth callback, publisher, cron, Stripe webhook, account deletion).
# Never put it in a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# Security (required for social publishing)
# ---------------------------------------------------------------------------
# 32-byte key, base64, encrypts social OAuth tokens at rest (AES-256-GCM).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes every stored token unreadable (users must reconnect).
TOKEN_ENCRYPTION_KEY=
# Shared secret for /api/cron/* (sent as "Authorization: Bearer $CRON_SECRET";
# Vercel Cron does this automatically).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ---------------------------------------------------------------------------
# AI provider (required for text + image generation)
# Any OpenAI-compatible API. AI_PROVIDER fills in sensible defaults; explicit
# OPENAI_* values always win.
#   openai       https://api.openai.com/v1           key required (production)
#   openrouter   https://openrouter.ai/api/v1        key required, many models
#   pollinations https://text.pollinations.ai/openai keyless DEMO ONLY
#                (~1 reply / 30 s per IP, may be overloaded)
# ---------------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=

# ---------------------------------------------------------------------------
# Email (notifications from the app: publish failures, expired accounts)
# EMAIL_PROVIDER: resend | smtp | log | none
#   Auto-detected when unset: resend if RESEND_API_KEY, smtp if SMTP_HOST,
#   otherwise "log" in development and "none" in production.
# Sign-up / password emails are sent by Supabase Auth: configure SMTP in the
# Supabase dashboard (Authentication -> SMTP), e.g. Resend SMTP below.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_FROM="ContentFlow <notifications@yourdomain.com>"
# Resend HTTP API
RESEND_API_KEY=
# Any SMTP server. Examples:
#   Resend:   SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_USER=resend SMTP_PASSWORD=<api key>
#   SES:      SMTP_HOST=email-smtp.<region>.amazonaws.com SMTP_PORT=587
#   Postmark: SMTP_HOST=smtp.postmarkapp.com SMTP_PORT=587
#   Local:    SMTP_HOST=127.0.0.1 SMTP_PORT=54325 (Mailpit from `supabase start`)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true = implicit TLS (port 465); default is STARTTLS on other ports
SMTP_SECURE=

# ---------------------------------------------------------------------------
# Social platforms (each optional; shown as "not configured" in Settings
# until its id + secret are set). See README "Connecting social platforms".
# Redirect URI to register: ${NEXT_PUBLIC_APP_URL}/api/social/{slug}/callback
# ---------------------------------------------------------------------------
# LinkedIn (slug: linkedin)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional Marketing API version YYYYMM
LINKEDIN_API_VERSION=
# "true" to request company-page scopes (needs Community Management API approval)
LINKEDIN_ORG_SCOPES=false

# Meta: Facebook Pages + Instagram professional accounts (slugs: facebook, instagram)
# META_APP_SECRET also verifies the data deletion callback
# (${NEXT_PUBLIC_APP_URL}/api/social/meta/data-deletion).
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
META_FACEBOOK_CONFIG_ID=
META_INSTAGRAM_CONFIG_ID=
META_EXTRA_SCOPES=

# X / Twitter (slug: x), OAuth 2.0 confidential client
X_CLIENT_ID=
X_CLIENT_SECRET=

# TikTok (slug: tiktok). Unaudited apps can only post privately.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_SCOPES=

# YouTube (slug: youtube), Google OAuth "Web application" client.
# Unverified Google Cloud projects can only upload private videos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_PRIVACY_STATUS=public

# ---------------------------------------------------------------------------
# Stripe (optional; paid plans are shown but not purchasable until set)
# One recurring monthly Price per paid plan. Webhook endpoint:
#   ${NEXT_PUBLIC_APP_URL}/api/billing/webhook
# events: checkout.session.completed, customer.subscription.created,
#   customer.subscription.updated, customer.subscription.deleted, invoice.paid
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_ENTERPRISE=
