# Copy this file to .env.local and fill in your own values.
# NEVER commit real credentials to the repository.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service-role key is only needed for server-side admin tasks / seed scripts.
# Keep it out of NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# n8n (optional, legacy — core flows no longer require n8n)
# The app reads the NEXT_PUBLIC_* names below at runtime in the browser.
NEXT_PUBLIC_N8N_API_URL=http://localhost:5678
NEXT_PUBLIC_N8N_API_KEY=your-n8n-api-key
NEXT_PUBLIC_N8N_CONTENT_GENERATION_WEBHOOK_URL=
NEXT_PUBLIC_N8N_IMAGE_GENERATION_WEBHOOK_URL=
NEXT_PUBLIC_N8N_MEDIA_GENERATION_WEBHOOK_URL=
NEXT_PUBLIC_N8N_VIDEO_STATUS_WEBHOOK_URL=
NEXT_PUBLIC_N8N_CREATE_POST_WEBHOOK_URL=
NEXT_PUBLIC_N8N_ADD_FEEDBACK_WEBHOOK_URL=

# AI provider (required for AI content + image generation)
# Any OpenAI-compatible API works. Pick one:
#   OpenAI:       OPENAI_BASE_URL=https://api.openai.com/v1 (default), OPENAI_API_KEY required
#   OpenRouter:   OPENAI_BASE_URL=https://openrouter.ai/api/v1, free :free models,
#                 free API key from openrouter.ai (no credit card), e.g.
#                 OPENAI_TEXT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#   Pollinations: OPENAI_BASE_URL=https://text.pollinations.ai/openai, no key needed,
#                 OPENAI_TEXT_MODEL=openai (image generation is routed automatically)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key
# Optional overrides (defaults: gpt-4o-mini / dall-e-3)
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3

# External media APIs (optional — needed only for video generation)
SHOTSTACK_API_KEY=your-shotstack-api-key
TAVUS_API_KEY=your-tavus-api-key

# Stripe (optional, required for billing).
# These are read as Supabase Edge Function secrets
# (supabase secrets set NEXT_PRIVATE_STRIPE_SECRET_KEY=...), not Next.js env.
NEXT_PRIVATE_STRIPE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PRIVATE_STRIPE_SECRET_KEY=your-secret-key
NEXT_PRIVATE_STRIPE_WEBHOOK_SECRET=your-webhook-secret
